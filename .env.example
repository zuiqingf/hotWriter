# DeepSeek API（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Tavily 搜索 API（选填，没有也能跑，会降级）
# 注册：https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Anthropic API（备用，如果将来要切 Claude）
ANTHROPIC_API_KEY=

# 数据库（MySQL，密码中的特殊字符如 # 必须 URL-encode 为 %23）
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/db_hotwriter?charset=utf8mb4

# 部署 basePath（客户端可见，必须与 next.config.js 里的 basePath 一致）
# - 本地 dev 通常留空，访问 http://localhost:3000
# - 反向代理部署时填子路径，如 /hotwriter（与 nginx location 同名）
# - Dockerfile 已默认填 /hotwriter；改路径时这里和 next.config.js 都要同步
NEXT_PUBLIC_BASE_PATH=
